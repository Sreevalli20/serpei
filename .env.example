# VITE_API_BASE_URL: Base URL of the backend FastAPI service (e.g., http://localhost:8000 or https://proofline-backend.onrender.com).
# Leave empty if the frontend and backend are hosted on the same origin.
# Note: SerpApi keys must NEVER be stored here or in the frontend client.
VITE_API_BASE_URL=""

# Backend environment variables (for Render deployment)
# SERPAPI_API_KEY: Your private SerpApi API key (NEVER commit to git)
# SEARCH_TIMEOUT_SECONDS: Maximum time to wait for SerpApi requests (default: 30)
# MAX_SEARCHES_PER_INVESTIGATION: Maximum number of search queries per investigation (default: 5)
# APP_ENV: Environment mode (development or production)

